# Copy this file to deployment/.env.local. Do not commit the copy.
# Cognito remains in AWS; obtain these values from its User Pool / App client.
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_REPLACE_ME
COGNITO_CLIENT_ID=REPLACE_ME

# These credentials are exclusively for the local PostgreSQL Docker container.
DB_NAME=compira
DB_SCHEMA=public
DB_USER=compira_admin
DB_PASSWORD=compira_local_password
